# Generate the three passwords independently with: openssl rand -hex 24
# Use hex passwords so the MySQL DSN needs no additional escaping.
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-different-random-hex
REDIS_PASSWORD=replace-with-another-random-hex
WECHAT_APP_ID=wxd791822444dad921
WECHAT_APP_SECRET=replace-with-app-secret
WECHAT_MINIPROGRAM_STATE=developer
API_PORT=18081
# Filled by deploy.sh after GitHub Actions publishes the image.
BACKEND_IMAGE=ghcr.io/flobby949/couple-mini-backend@sha256:replace-with-image-digest
