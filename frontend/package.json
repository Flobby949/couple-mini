{
  "name": "couple-mini-frontend",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch --port 10086",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:weapp": "pnpm build:weapp && node scripts/check-weapp.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "abort-controller": "3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/react-test-renderer": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "babel-preset-taro": "4.3.0",
    "dotenv": "16.6.1",
    "react-test-renderer": "18.3.1",
    "sass": "1.93.2",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vite": "4.5.14",
    "vitest": "3.2.4"
  }
}
